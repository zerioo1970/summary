{
  "name": "h5-frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('../Backend/wwwroot', { recursive: true, force: true })\"",
    "copy": "node -e \"require('node:fs').cpSync('index.html', '../Backend/wwwroot/index.html')\"",
    "build": "tsc --noEmit && npm run clean && tsc && npm run copy"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
